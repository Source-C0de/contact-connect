# ContactHub — full stack.
#
# `docker compose up -d` starts the whole system: the SPA + API, PostgreSQL,
# and the complete observability stack (Prometheus, Loki, Promtail, Grafana,
# Alertmanager) plus the on-call responder agent.
#
# The observability services are behind the `observability` profile by
# default so that the app alone stays quick to start locally:
#
#   docker compose up -d                  # app + db only
#   docker compose --profile observability up -d   # + the full monitoring stack
#
# In production (CI/CD) we start with the `observability` profile enabled.

services:
  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: contacthub
      POSTGRES_PASSWORD: contacthub
      POSTGRES_DB: contacthub
    volumes:
      - contacthub-postgres:/var/lib/postgresql/data
    # Published to the host so the API server can be run OUTSIDE Docker
    # during local development (`npm run dev`) against the same database.
    # The host port is overridable via POSTGRES_HOST_PORT.
    ports:
      - "${POSTGRES_HOST_PORT:-5432}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U contacthub -d contacthub"]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 5s

  app:
    build:
      context: .
      dockerfile: Dockerfile
    image: contacthub:latest
    # No explicit container_name — let Compose derive it (e.g. `contacts_app_1`).
    # A fixed name + Compose v1 (docker-compose 1.29.x) recreates crashes on
    # modern Docker Engine because v1 reads the deprecated `ContainerConfig`
    # field from `docker image inspect` that the Engine no longer populates.
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    # Host port is overridable via APP_HOST_PORT. The default is 8090, but
    # 8080-8108 sits inside the Windows excluded-port range (8009-8108) on
    # many machines, which makes the publish fail with "ports are not
    # available". Set APP_HOST_PORT=8123 in .env if you hit that.
    ports:
      - "${APP_HOST_PORT:-8090}:8090"
    environment:
      NODE_ENV: production
      PORT: "8090"
      HOST: "0.0.0.0"
      DATABASE_URL: postgres://contacthub:contacthub@db:5432/contacthub
      # Keep DATA_FILE pointing at the legacy file so the one-shot
      # `npm run migrate` script can find it inside the container.
      DATA_FILE: /data/data.json
      # Uploaded profile pictures. Lives inside the `contacthub-data` volume
      # so the pictures survive an image rebuild. Note that
      # `docker compose down -v` deletes the volume and the pictures with it.
      UPLOADS_DIR: /data/uploads
      # Structured logging. `json` is what Promtail parses; `pretty` is
      # friendlier when running the container by hand.
      LOG_FORMAT: "${LOG_FORMAT:-json}"
      LOG_LEVEL: "${LOG_LEVEL:-info}"
      # Persist the session secret across container restarts so already-issued
      # tokens remain valid. Leave unset to let the server auto-generate one
      # on first boot and persist it into the `settings` table.
      # SESSION_SECRET: "change-me-to-a-long-random-string"
    volumes:
      - contacthub-data:/data

  # ------------------------------------------------------------------ #
  #  Observability stack
  # ------------------------------------------------------------------ #

  prometheus:
    image: prom/prometheus:v2.55.1
    profiles: ["observability"]
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=15d
      - --web.enable-lifecycle
    volumes:
      - ./observability/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./observability/prometheus/rules:/etc/prometheus/rules:ro
      - prometheus-data:/prometheus
    ports:
      - "${PROMETHEUS_PORT:-9090}:9090"
    depends_on:
      - app

  loki:
    image: grafana/loki:3.2.1
    profiles: ["observability"]
    restart: unless-stopped
    command: ["-config.file=/etc/loki/loki-config.yml"]
    volumes:
      - ./observability/loki/loki-config.yml:/etc/loki/loki-config.yml:ro
      - loki-data:/loki
    ports:
      - "${LOKI_PORT:-3100}:3100"

  promtail:
    image: grafana/promtail:3.2.1
    profiles: ["observability"]
    restart: unless-stopped
    command: ["-config.file=/etc/promtail/promtail-config.yml"]
    volumes:
      - ./observability/promtail/promtail-config.yml:/etc/promtail/promtail-config.yml:ro
      # Promtail discovers containers via the Docker socket so it can pick up
      # the app's stdout automatically.
      - /var/run/docker.sock:/var/run/docker.sock:ro
    depends_on:
      - loki

  grafana:
    image: grafana/grafana:11.3.1
    profiles: ["observability"]
    restart: unless-stopped
    environment:
      GF_SECURITY_ADMIN_USER: "${GRAFANA_ADMIN_USER:-admin}"
      GF_SECURITY_ADMIN_PASSWORD: "${GRAFANA_ADMIN_PASSWORD:-admin}"
      # Anonymous read access so a reviewer can open the dashboard without
      # hunting for credentials. Set GRAFANA_AUTH_ANONYMOUS=false to lock down.
      GF_AUTH_ANONYMOUS_ENABLED: "${GRAFANA_AUTH_ANONYMOUS:-true}"
      GF_AUTH_ANONYMOUS_ORG_ROLE: Viewer
      GF_USERS_DEFAULT_THEME: light
    volumes:
      - ./observability/grafana/provisioning:/etc/grafana/provisioning:ro
      - grafana-data:/var/lib/grafana
    ports:
      - "${GRAFANA_PORT:-3000}:3000"
    depends_on:
      - prometheus
      - loki

  alertmanager:
    image: prom/alertmanager:v0.27.0
    profiles: ["observability"]
    restart: unless-stopped
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
    volumes:
      - ./observability/alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - alertmanager-data:/alertmanager
    ports:
      - "${ALERTMANAGER_PORT:-9093}:9093"
    depends_on:
      - prometheus

  # The responder: wakes up on an Alertmanager webhook and fixes the issue.
  oncall-agent:
    build:
      context: .
      dockerfile: oncall-agent/Dockerfile
    image: contacthub-oncall-agent:latest
    profiles: ["observability"]
    restart: unless-stopped
    environment:
      ONCALL_PORT: "8080"
      ONCALL_HOST: "0.0.0.0"
      ONCALL_API_URL: "http://app:8090"
      ONCALL_COMPOSE_FILE: "/app/docker-compose.yml"
      # Dry-run by default: the agent reports what it *would* do. Set to
      # false to let it actually restart containers.
      ONCALL_DRY_RUN: "${ONCALL_DRY_RUN:-true}"
      ONCALL_COOLDOWN_MS: "${ONCALL_COOLDOWN_MS:-300000}"
    volumes:
      - ./docker-compose.yml:/app/docker-compose.yml:ro
      # The agent needs the Docker socket to restart the app container.
      - /var/run/docker.sock:/var/run/docker.sock
    ports:
      - "${ONCALL_PORT:-8080}:8080"
    depends_on:
      - app
      - alertmanager

volumes:
  contacthub-data:
    name: contacthub-data
  contacthub-postgres:
    name: contacthub-postgres
  prometheus-data:
    name: contacthub-prometheus
  loki-data:
    name: contacthub-loki
  grafana-data:
    name: contacthub-grafana
  alertmanager-data:
    name: contacthub-alertmanager
