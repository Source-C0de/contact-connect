# Local development environment for ContactHub.
# Copy to `.env` (git-ignored) and adjust as needed.

# Port the API server listens on during `npm run dev`.
# NOTE: 8080 and 8090 fall inside the Windows excluded-port range
# (8009-8108) on many machines, which makes binding fail with EACCES.
# 8123 is a safe default.
VITE_API_PORT=8123

# Port the Vite dev server listens on during `npm run dev`.
# 5173 is often taken by another dev server on the same machine; if you get
# "Port 5173 is already in use", bump this to a free port.
VITE_DEV_PORT=5180

# Full API base URL. Leave empty in dev so the app derives it from
# VITE_API_PORT + the page hostname (so LAN colleagues are auto-detected).
# Set it explicitly to override, e.g. when the SPA is hosted behind nginx:
# VITE_API_URL=https://contacts.example.com/api/v1

# Postgres connection string used by the API server in local dev.
# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgres://contacthub:contacthub@localhost:5432/contacthub
