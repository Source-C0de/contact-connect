# ContactHub — local environment configuration.
# Copy to `.env` (git-ignored) and adjust as needed.
#
#   cp .env.example .env
#
# This file is read by BOTH the Vite dev server and the API server
# (see server/env.js). Values here only affect local development;
# the Docker stack gets its settings from docker-compose.yml.

# ---------------------------------------------------------------------------
# Development ports
# ---------------------------------------------------------------------------

# Port the Vite dev server binds. Browse to http://localhost:<this port>.
# 5173 is often taken by another dev server on the same machine; if you get
# "Port 5173 is already in use", bump this to a free port.
VITE_DEV_PORT=5180

# Port the API server binds during `npm run dev`.
# NOTE: 8080 and 8090 fall inside the Windows excluded-port range
# (8009-8108) on many machines, which makes binding fail with EACCES.
# 8123 is a safe default.
PORT=8123

# Port the BROWSER uses to reach the API in development. Must match the
# PORT above — the browser and the server have to agree.
VITE_API_PORT=8123

# Full API base URL. Leave unset in dev so the app derives it from
# VITE_API_PORT + the page hostname (so LAN colleagues are auto-detected).
# Set it explicitly to override, e.g. when the SPA is hosted behind nginx:
# VITE_API_URL=https://contacts.example.com/api/v1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Postgres connection string used by the API server in local dev.
# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgres://contacthub:contacthub@localhost:5432/contacthub

# ---------------------------------------------------------------------------
# Docker host ports
# ---------------------------------------------------------------------------

# Host port published by the Docker `app` container.
# Everyone on the LAN opens: http://<server-ip>:<this port>
APP_HOST_PORT=8090

# Host port published by the Docker `db` container.
# Only needs to be reachable by the server itself.
POSTGRES_HOST_PORT=5432
